{
  "name": "visitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "import:visit-jersey": "tsx scripts/import-visit-jersey.ts",
    "seed:sample": "tsx scripts/import-visit-jersey.ts --fixture tests/fixtures/visit-jersey-listings.json",
    "auth:create-user": "tsx scripts/auth-create-user.ts",
    "seed:provider-codes": "tsx scripts/seed-provider-codes.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "drizzle-orm": "0.36.4",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "postgres": "3.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.14",
    "@types/node": "22.10.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
