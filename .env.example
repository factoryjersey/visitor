# Postgres (Supabase or plain). Same shape as factoryOS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visitor

# Supabase Auth: visitor's own project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: accepting an invite with a password, and auth:create-user.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL; OAuth redirects are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Become superadmin on first sign-in, comma-separated. Everyone else is invited.
SUPERADMIN_EMAILS=
