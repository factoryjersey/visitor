# Postgres (Supabase or plain). Same shape as factoryOS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visitor

# Supabase Auth. Use factoryOS's project so the same accounts work in both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only for scripts/auth-create-user.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL; OAuth redirects are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Who may sign in. Leave unset locally; "factory.je" in production.
ALLOWED_EMAIL_DOMAINS=
